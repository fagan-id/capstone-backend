{
  "info": {
    "_postman_id": "c7a8b9f1-32e4-4d89-9a7b-e1f2a3b4c5d6",
    "name": "Skrining ABK - Public Screening API (Orang Tua / Siswa)",
    "description": "Koleksi Postman lengkap untuk pengujian end-to-end 18 tahapan alur skrining ABK sesuai desain UI. Pengambilan pertanyaan menggunakan idTest dan hasil_skrining dicatat saat submit final.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "kodeSesi",
      "value": "ABC123",
      "type": "string"
    },
    {
      "key": "idTest",
      "value": "1",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "3",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Fase 1: Onboarding & Verifikasi Identitas",
      "item": [
        {
          "name": "1. Validasi Kode Sesi (Layar 1 & 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kodeSesi\": \"{{kodeSesi}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/public/skrining/sesi/validasi",
              "host": ["{{baseUrl}}"],
              "path": ["public", "skrining", "sesi", "validasi"]
            },
            "description": "Layar 1 (Input Kode Sesi) & Layar 2 (Konfirmasi Sesi Sekolah & NPSN)."
          }
        },
        {
          "name": "2. Cari Siswa Autocomplete (Layar 3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/skrining/sesi/{{kodeSesi}}/siswa?search=Ahmad",
              "host": ["{{baseUrl}}"],
              "path": ["public", "skrining", "sesi", "{{kodeSesi}}", "siswa"],
              "query": [
                {
                  "key": "search",
                  "value": "Ahmad",
                  "description": "Minimal 3 karakter nama siswa"
                }
              ]
            },
            "description": "Layar 3: Autocomplete pencarian siswa di sekolah sesi tersebut."
          }
        },
        {
          "name": "3. Konfirmasi Data Siswa (Layar 4)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/skrining/sesi/{{kodeSesi}}/siswa/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["public", "skrining", "sesi", "{{kodeSesi}}", "siswa", "{{studentId}}"]
            },
            "description": "Layar 4: Menampilkan data lengkap anak (Nama, NISN, Kelas, Jenis Kelamin)."
          }
        },
        {
          "name": "4. Registrasi Kontak Orang Tua & Consent (Layar 5 & 6)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kodeSesi\": \"{{kodeSesi}}\",\n  \"studentId\": {{studentId}},\n  \"namaOrangTua\": \"Susilo\",\n  \"nomorHp\": \"08964732819\",\n  \"hubungan\": \"orang_tua\",\n  \"persetujuan\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/public/skrining/mulai",
              "host": ["{{baseUrl}}"],
              "path": ["public", "skrining", "mulai"]
            },
            "description": "Layar 5 & 6: Memvalidasi kontak orang tua dan consent. Mengembalikan idTest (1) tanpa membuat baris prematur di hasil_skrining."
          }
        }
      ]
    },
    {
      "name": "Fase 2: Skrining Awal (Level 1)",
      "item": [
        {
          "name": "5. Ambil Pertanyaan Skrining Awal by idTest (Layar 7)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/skrining/tes/{{idTest}}/pertanyaan",
              "host": ["{{baseUrl}}"],
              "path": ["public", "skrining", "tes", "{{idTest}}", "pertanyaan"]
            },
            "description": "Layar 7: Memuat seluruh butir pertanyaan instrumen berdasarkan idTest (Skrining Awal = idTest: 1)."
          }
        },
        {
          "name": "6. Submit Skrining Awal Lengkap (Layar 8 & 9)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kodeSesi\": \"{{kodeSesi}}\",\n  \"studentId\": {{studentId}},\n  \"testId\": 1,\n  \"responden\": {\n    \"namaLengkap\": \"Susilo\",\n    \"nomorHp\": \"08964732819\",\n    \"hubungan\": \"orang_tua\"\n  },\n  \"jawaban\": [\n    { \"idPertanyaan\": 1, \"idOpsi\": 1 },\n    { \"idPertanyaan\": 2, \"idOpsi\": 2 },\n    { \"idPertanyaan\": 3, \"idOpsi\": 3 },\n    { \"idPertanyaan\": 4, \"idOpsi\": 4 },\n    { \"idPertanyaan\": 5, \"idOpsi\": 24 },\n    { \"idPertanyaan\": 6, \"idOpsi\": 26 },\n    { \"idPertanyaan\": 7, \"idOpsi\": 31 },\n    { \"idPertanyaan\": 8, \"idOpsi\": 36 },\n    { \"idPertanyaan\": 9, \"idOpsi\": 41 },\n    { \"idPertanyaan\": 10, \"idOpsi\": 46 },\n    { \"idPertanyaan\": 11, \"idOpsi\": 51 },\n    { \"idPertanyaan\": 12, \"idOpsi\": 56 },\n    { \"idPertanyaan\": 13, \"idOpsi\": 61 },\n    { \"idPertanyaan\": 14, \"idOpsi\": 66 },\n    { \"idPertanyaan\": 15, \"idOpsi\": 71 },\n    { \"idPertanyaan\": 16, \"idOpsi\": 76 },\n    { \"idPertanyaan\": 17, \"idOpsi\": 81 },\n    { \"idPertanyaan\": 18, \"idOpsi\": 86 },\n    { \"idPertanyaan\": 19, \"idOpsi\": 91 },\n    { \"idPertanyaan\": 20, \"idOpsi\": 96 },\n    { \"idPertanyaan\": 21, \"idOpsi\": 101 },\n    { \"idPertanyaan\": 22, \"idOpsi\": 106 },\n    { \"idPertanyaan\": 23, \"idOpsi\": 111 },\n    { \"idPertanyaan\": 24, \"idOpsi\": 116 },\n    { \"idPertanyaan\": 25, \"idOpsi\": 121 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/public/skrining/submit",
              "host": ["{{baseUrl}}"],
              "path": ["public", "skrining", "submit"]
            },
            "description": "Layar 8 & 9: Mengirimkan jawaban lengkap. Backend menghitung skor, mengevaluasi kesimpulan indikasi, mencatat hasil ke tabel hasil_skrining & detail_jawaban_siswa."
          }
        }
      ]
    },
    {
      "name": "Fase 3: Multi-Instrumen Tindak Lanjut (Level 2)",
      "item": [
        {
          "name": "7. Dashboard Tindak Lanjut (Layar 10, 14, 18)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/skrining/tindak-lanjut?kodeSesi={{kodeSesi}}&studentId={{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["public", "skrining", "tindak-lanjut"],
              "query": [
                {
                  "key": "kodeSesi",
                  "value": "{{kodeSesi}}"
                },
                {
                  "key": "studentId",
                  "value": "{{studentId}}"
                }
              ]
            },
            "description": "Memuat daftar instrumen lanjutan (A, B, C), status (aktif / terkunci / selesai), dan progres pengisian."
          }
        },
        {
          "name": "8. Ambil Soal Instrumen A by idTest: 2 (Layar 11)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/skrining/tes/2/pertanyaan",
              "host": ["{{baseUrl}}"],
              "path": ["public", "skrining", "tes", "2", "pertanyaan"]
            },
            "description": "Layar 11: Memuat pertanyaan Instrumen A (idTest: 2, 8 butir skala 4-poin)."
          }
        },
        {
          "name": "9. Submit Instrumen A (Layar 12 & 13)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kodeSesi\": \"{{kodeSesi}}\",\n  \"studentId\": {{studentId}},\n  \"testId\": 2,\n  \"jawaban\": [\n    { \"idPertanyaan\": 26, \"idOpsi\": 126 },\n    { \"idPertanyaan\": 27, \"idOpsi\": 131 },\n    { \"idPertanyaan\": 28, \"idOpsi\": 134 },\n    { \"idPertanyaan\": 29, \"idOpsi\": 138 },\n    { \"idPertanyaan\": 30, \"idOpsi\": 142 },\n    { \"idPertanyaan\": 31, \"idOpsi\": 146 },\n    { \"idPertanyaan\": 32, \"idOpsi\": 150 },\n    { \"idPertanyaan\": 33, \"idOpsi\": 154 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/public/skrining/submit",
              "host": ["{{baseUrl}}"],
              "path": ["public", "skrining", "submit"]
            },
            "description": "Layar 12 & 13: Submit Instrumen A, mencatat hasil ke tabel hasil_skrining."
          }
        },
        {
          "name": "10. Ambil Soal Instrumen C by idTest: 4 (Layar 15)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/skrining/tes/4/pertanyaan",
              "host": ["{{baseUrl}}"],
              "path": ["public", "skrining", "tes", "4", "pertanyaan"]
            },
            "description": "Layar 15: Memuat pertanyaan Instrumen C (idTest: 4, 11 butir skala 5-poin emosi)."
          }
        },
        {
          "name": "11. Submit Instrumen C (Layar 16 & 17)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kodeSesi\": \"{{kodeSesi}}\",\n  \"studentId\": {{studentId}},\n  \"testId\": 4,\n  \"jawaban\": [\n    { \"idPertanyaan\": 39, \"idOpsi\": 175 },\n    { \"idPertanyaan\": 40, \"idOpsi\": 184 },\n    { \"idPertanyaan\": 41, \"idOpsi\": 186 },\n    { \"idPertanyaan\": 42, \"idOpsi\": 191 },\n    { \"idPertanyaan\": 43, \"idOpsi\": 196 },\n    { \"idPertanyaan\": 44, \"idOpsi\": 201 },\n    { \"idPertanyaan\": 45, \"idOpsi\": 206 },\n    { \"idPertanyaan\": 46, \"idOpsi\": 211 },\n    { \"idPertanyaan\": 47, \"idOpsi\": 216 },\n    { \"idPertanyaan\": 48, \"idOpsi\": 221 },\n    { \"idPertanyaan\": 49, \"idOpsi\": 226 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/public/skrining/submit",
              "host": ["{{baseUrl}}"],
              "path": ["public", "skrining", "submit"]
            },
            "description": "Layar 16 & 17: Submit Instrumen C."
          }
        },
        {
          "name": "12. Cek Status Akhir 100% Selesai (Layar 18)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/skrining/tindak-lanjut?kodeSesi={{kodeSesi}}&studentId={{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["public", "skrining", "tindak-lanjut"],
              "query": [
                {
                  "key": "kodeSesi",
                  "value": "{{kodeSesi}}"
                },
                {
                  "key": "studentId",
                  "value": "{{studentId}}"
                }
              ]
            },
            "description": "Layar 18: Memastikan progres seluruh instrumen selesai dikerjakan (100%) dan pesan penutup."
          }
        }
      ]
    }
  ]
}
