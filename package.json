{
  "name": "capstone-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.js",
    "start": "tsx src/server.js",
    "test": "tsx --test \"tests/*.test.js\"",
    "test:db": "tsx --test \"tests/db/*.dbtest.js\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.js",
    "db:seed": "prisma db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "express": "5.3.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
