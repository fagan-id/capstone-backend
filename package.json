{
  "name": "capstone-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.js",
    "start": "tsx src/server.js",
    "test": "tsx --test",
    "test:db": "tsx --test tests/db/skema.dbtest.js tests/db/seed.dbtest.js tests/db/skrining.dbtest.js tests/db/skriningOrangTua.dbtest.js tests/db/alurPercabanganSkrining.dbtest.js tests/db/superAdminKelolaSekolah.dbtest.js",
    "test:screening": "tsx --test tests/db/alurPercabanganSkrining.dbtest.js",
    "test:screening:verbose": "tsx scripts/test-screening.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "6.0.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
