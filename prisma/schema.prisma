// Skema Prisma untuk capstone-backend (Sistem Skrining ABK).
// Desain: docs/superpowers/specs/2026-10-27-accounts-students-schema-design.md
//         docs/superpowers/specs/2026-11-03-integrasi-modul-skrining-publik-design.md
// Penamaan mengikuti D20/D39: snake_case Indonesia, PK `id`, FK `<tabel>_id`,
// nama model sama dengan nama tabel, kecuali `created_at` / `updated_at` yang tetap Inggris.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

enum jenis_kelamin {
  L
  P
}

enum status_sesi {
  menunggu
  aktif
  selesai
}

enum tipe_jawaban {
  skala
  ya_tidak
}

model super_admin {
  id            Int      @id @default(autoincrement())
  nama          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(191)
  password_hash String   @db.VarChar(255)
  aktif         Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tes_skrining tes_skrining[]
}

model sekolah {
  id             Int      @id @default(autoincrement())
  npsn           String   @unique @db.Char(8)
  nama           String   @db.VarChar(150)
  alamat         String?  @db.VarChar(255)
  email          String   @unique @db.VarChar(191)
  username       String   @unique @db.VarChar(50)
  password_hash  String   @db.VarChar(255)
  kontak_telepon String?  @db.VarChar(20)
  aktif          Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  kelas         kelas[]
  siswa         siswa[]
  sesi_skrining sesi_skrining[]
}

model kelas {
  id           Int      @id @default(autoincrement())
  sekolah_id   Int
  nama         String   @db.VarChar(20)
  tingkat      Int      @db.UnsignedTinyInt
  tahun_ajaran String   @db.Char(9)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  sekolah sekolah @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  siswa   siswa[]

  @@unique([sekolah_id, tahun_ajaran, nama])
  @@unique([id, sekolah_id])
}

model siswa {
  id            Int           @id @default(autoincrement())
  sekolah_id    Int
  kelas_id      Int
  nisn          String        @unique @db.Char(10)
  nama          String        @db.VarChar(150)
  tanggal_lahir DateTime      @db.Date
  jenis_kelamin jenis_kelamin
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  sekolah sekolah @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  // onUpdate: Restrict — tanpa ini, mengubah kelas.sekolah_id ikut memindahkan siswanya ke sekolah lain.
  kelas   kelas   @relation(fields: [kelas_id, sekolah_id], references: [id, sekolah_id], onDelete: Restrict, onUpdate: Restrict)

  hasil_skrining hasil_skrining[]

  @@index([sekolah_id, nama])
}

/// Domain DSM-5 pada skrining awal. Ambang batasnya dipakai per butir, bukan per jumlah (D43).
model kategori_asesmen {
  id              Int      @id @default(autoincrement())
  nama            String   @db.VarChar(100)
  ambang_batas    Int      @db.UnsignedTinyInt
  tes_skrining_id Int?
  deskripsi       String?  @db.Text
  rekomendasi     String?  @db.Text
  urutan          Int      @db.UnsignedTinyInt
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Instrumen Level 2 untuk domain ini. Kosong berarti domain hanya ditandai untuk sekolah (D34).
  tes_skrining   tes_skrining?    @relation(fields: [tes_skrining_id], references: [id], onDelete: Restrict)
  pertanyaan     pertanyaan[]
  hasil_kategori hasil_kategori[]

  @@unique([urutan])
  @@index([tes_skrining_id])
}

model tes_skrining {
  id             Int      @id @default(autoincrement())
  super_admin_id Int
  nama           String   @db.VarChar(150)
  level          Int      @db.UnsignedTinyInt
  jenjang        String   @db.VarChar(50)
  deskripsi      String   @db.Text
  aktif          Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  super_admin      super_admin        @relation(fields: [super_admin_id], references: [id], onDelete: Restrict)
  pertanyaan       pertanyaan[]
  kategori_asesmen kategori_asesmen[]
  hasil_tes        hasil_tes[]

  @@index([super_admin_id])
  @@index([level, aktif])
}

model sesi_skrining {
  id                  Int         @id @default(autoincrement())
  sekolah_id          Int
  nama                String      @db.VarChar(150)
  kode                String      @unique @db.VarChar(20)
  tanggal_pelaksanaan DateTime    @db.Date
  status              status_sesi
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  sekolah        sekolah          @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  hasil_skrining hasil_skrining[]

  @@index([sekolah_id])
}

model pertanyaan {
  id                  Int          @id @default(autoincrement())
  tes_skrining_id     Int
  kategori_asesmen_id Int
  teks                String       @db.Text
  tipe_jawaban        tipe_jawaban
  nomor_urut          Int          @db.UnsignedSmallInt
  url_gambar          String?      @db.VarChar(255)
  aktif               Boolean      @default(true)
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  tes_skrining     tes_skrining     @relation(fields: [tes_skrining_id], references: [id], onDelete: Restrict)
  kategori_asesmen kategori_asesmen @relation(fields: [kategori_asesmen_id], references: [id], onDelete: Restrict)
  opsi_jawaban     opsi_jawaban[]
  jawaban_siswa    jawaban_siswa[]

  @@unique([tes_skrining_id, nomor_urut])
  @@index([kategori_asesmen_id])
}

model opsi_jawaban {
  id            Int      @id @default(autoincrement())
  pertanyaan_id Int
  label         String   @db.VarChar(10)
  teks          String   @db.VarChar(255)
  skor          Int      @db.UnsignedTinyInt
  urutan        Int      @db.UnsignedTinyInt
  url_gambar    String?  @db.VarChar(255)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  pertanyaan    pertanyaan      @relation(fields: [pertanyaan_id], references: [id], onDelete: Restrict)
  jawaban_siswa jawaban_siswa[]

  @@unique([pertanyaan_id, urutan])
}

/// Satu percobaan pengisian oleh orang tua. Rute publik mengaksesnya lewat `token`, bukan `id`.
model hasil_skrining {
  id                 Int       @id @default(autoincrement())
  siswa_id           Int
  sesi_skrining_id   Int
  token              String    @unique @db.Char(36)
  nama_responden     String    @db.VarChar(150)
  nomor_hp_responden String    @db.VarChar(20)
  hubungan_responden String    @db.VarChar(50)
  waktu_persetujuan  DateTime
  waktu_mulai        DateTime
  waktu_selesai      DateTime?
  selesai            Boolean   @default(false)
  kesimpulan         String?   @db.Text
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  siswa          siswa            @relation(fields: [siswa_id], references: [id], onDelete: Restrict)
  sesi_skrining  sesi_skrining    @relation(fields: [sesi_skrining_id], references: [id], onDelete: Restrict)
  jawaban_siswa  jawaban_siswa[]
  hasil_kategori hasil_kategori[]
  hasil_tes      hasil_tes[]

  @@unique([siswa_id, sesi_skrining_id])
  @@index([sesi_skrining_id])
}

model jawaban_siswa {
  id                Int      @id @default(autoincrement())
  hasil_skrining_id Int
  pertanyaan_id     Int
  opsi_jawaban_id   Int
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  hasil_skrining hasil_skrining @relation(fields: [hasil_skrining_id], references: [id], onDelete: Restrict)
  pertanyaan     pertanyaan     @relation(fields: [pertanyaan_id], references: [id], onDelete: Restrict)
  opsi_jawaban   opsi_jawaban   @relation(fields: [opsi_jawaban_id], references: [id], onDelete: Restrict)

  @@unique([hasil_skrining_id, pertanyaan_id])
  @@index([pertanyaan_id])
  @@index([opsi_jawaban_id])
}

/// Hasil per domain, ditulis sekali saat skrining awal dikirim. Ambangnya ikut disimpan (D35, D41).
model hasil_kategori {
  id                  Int      @id @default(autoincrement())
  hasil_skrining_id   Int
  kategori_asesmen_id Int
  skor_tertinggi      Int      @db.UnsignedTinyInt
  ambang_batas        Int      @db.UnsignedTinyInt
  terindikasi         Boolean
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  hasil_skrining   hasil_skrining   @relation(fields: [hasil_skrining_id], references: [id], onDelete: Restrict)
  kategori_asesmen kategori_asesmen @relation(fields: [kategori_asesmen_id], references: [id], onDelete: Restrict)

  @@unique([hasil_skrining_id, kategori_asesmen_id])
  @@index([kategori_asesmen_id])
}

/// Satu baris per instrumen yang diberikan ke anak: Level 1 saat mulai, Level 2 per domain terindikasi.
model hasil_tes {
  id                Int       @id @default(autoincrement())
  hasil_skrining_id Int
  tes_skrining_id   Int
  total_skor        Int?      @db.UnsignedSmallInt
  selesai           Boolean   @default(false)
  waktu_selesai     DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  hasil_skrining hasil_skrining @relation(fields: [hasil_skrining_id], references: [id], onDelete: Restrict)
  tes_skrining   tes_skrining   @relation(fields: [tes_skrining_id], references: [id], onDelete: Restrict)

  @@unique([hasil_skrining_id, tes_skrining_id])
  @@index([tes_skrining_id])
}
